rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return estaLogueado() && request.auth.uid == uid;
    }

    function esAdministrador() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

     match /usuarios/{uid} {
      allow read: if esDueno(uid) || esAdministrador();
      allow create: if esDueno(uid);
      allow update: if esDueno(uid) || esAdministrador();
      allow delete: if false;
    }

    match /canchas/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /configuracion/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /disponibilidad/{id} {
      allow read: if estaLogueado();
      allow write: if esAdministrador();
    }

    match /turnos/{id} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() &&
        request.resource.data.clienteId == request.auth.uid;
      allow update: if estaLogueado() &&
        (resource.data.clienteId == request.auth.uid || esAdministrador());
      allow delete: if false;
    }

  match /turnosFijos/{id} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() &&
        request.resource.data.clienteId == request.auth.uid;
      allow update: if estaLogueado() &&
        (resource.data.clienteId == request.auth.uid || esAdministrador());
      allow delete: if false;
    } 

    match /cupones/{id} {
     allow read: if esAdministrador() ||
     (estaLogueado() && resource.data.clienteId == request.auth.uid);
     allow create: if estaLogueado() &&
       request.resource.data.clienteId == request.auth.uid;
     allow update: if esAdministrador() ||
     (estaLogueado() && resource.data.clienteId == request.auth.uid);
     allow delete: if false;
    }
  
  }
}